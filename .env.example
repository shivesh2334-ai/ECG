# Anthropic Claude API Key (server-side)
# This key is used SERVER-SIDE only via the /api/anthropic serverless proxy.
# It is NOT exposed to the browser. Set this in your Vercel project environment variables.
ANTHROPIC_API_KEY=

# Anthropic Claude API Key (client-side, Vite)
# The VITE_ prefix exposes this variable to client-side code via import.meta.env.
# For local development, copy this file to .env and fill in your key.
VITE_ANTHROPIC_API_KEY=your_api_key_here
